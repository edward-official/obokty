# ============================================================
# .env.production.example
# 이 파일은 Git에 커밋해도 안전한 템플릿입니다.
# EC2 서버에서 이 파일을 복사하여 .env.production으로 이름 변경 후
# 실제 값을 채워 넣으세요.
# cp .env.production.example .env.production
# ============================================================


# ============================================================
# PostgreSQL (AWS RDS)
# ============================================================
# RDS 생성 후 콘솔 > 연결 & 보안 탭에서 확인
RDS_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=obokty_db


# ============================================================
# JWT 인증
# ============================================================
# 아래 명령어로 안전한 랜덤 키 생성: openssl rand -hex 32
SECRET_KEY=replace-with-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ============================================================
# Frontend 공개 API 주소 (실제 도메인으로 변경)
# ============================================================
NEXT_PUBLIC_AUTH_API_URL=https://your-domain.com/auth
NEXT_PUBLIC_GAME_API_URL=https://your-domain.com/game
NEXT_PUBLIC_GAME_WS_URL=wss://your-domain.com/ws
